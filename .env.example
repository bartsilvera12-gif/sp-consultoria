# ============================================================
# Variables de entorno — SP Consultoría (panel admin con Supabase)
# Copiá este archivo como .env.local y completá los valores.
# .env.local NO se sube a GitHub.
# ============================================================

# Credenciales PÚBLICAS de Supabase (seguras para el navegador).
# La URL es la de la API de Supabase; la anon key es la clave pública (JWT).
NEXT_PUBLIC_SUPABASE_URL=https://api.neura.com.py
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# IMPORTANTE:
# - NUNCA pongas acá la service_role key.
# - NUNCA pongas acá la contraseña ni la cadena de conexión directa a Postgres.
# - Esas credenciales son de servidor/administración y no van en el frontend.
